#!/bin/sh
# SPDX-License-Identifier: MIT
# Install the camera-effects network and tuning from the user's own macOS install for the Neural Engine
# effects plugin.
#
#   sudo install-apple-effects DIR      install from DIR
#   sudo install-apple-effects --remove remove them (the companion plugin, if any, is used again)
#   install-apple-effects --status
#
# DIR/segmentation holds the person and skin segmentation network as the user's macOS compiled it for this
# Mac's Neural Engine, with the four sections the Linux accel/ane driver loads with it: model.hwx,
# generic.bin, operation.bin, procedure.bin, text-properties.bin. The driver checks the program when it
# loads it. DIR/tuning/*.conf (optional) is the effects' tuning from the same install ("key = value"
# lines; framing.conf turns Center Stage on). Nothing is downloaded and nothing of it ships with this
# package.
set -eu
DEST=/var/lib/aurora-camera-denoise/apple
NETS="segmentation"
FILES="model.hwx generic.bin operation.bin procedure.bin text-properties.bin"

status() {
	for n in $NETS; do
		if [ -r "$DEST/$n/model.hwx" ]; then
			echo "$n: installed ($(sha256sum "$DEST/$n/model.hwx" | cut -c1-16))"
		else
			echo "$n: not installed"
		fi
	done
	for t in "$DEST"/tuning/*.conf; do
		[ -r "$t" ] && echo "tuning: $(basename "$t")"
	done
	ls /dev/accel/accel* >/dev/null 2>&1 || echo "note: no /dev/accel node (accel/ane driver not loaded)"
}

case "${1:-}" in
--status | "")
	status
	exit 0
	;;
--remove)
	for n in $NETS tuning; do rm -rf "${DEST:?}/$n"; done
	status
	exit 0
	;;
esac
SRC=$1
[ "$(id -u)" = 0 ] || { echo "needs root: sudo $0 $SRC" >&2; exit 1; }
for n in $NETS; do
	for f in $FILES; do
		[ -s "$SRC/$n/$f" ] || { echo "$SRC/$n/$f missing" >&2; exit 1; }
	done
done
umask 022
mkdir -p "$DEST"
for n in $NETS; do
	tmp="$DEST/.$n.new"
	rm -rf "$tmp" && mkdir -p "$tmp"
	for f in $FILES; do install -m 0644 "$SRC/$n/$f" "$tmp/$f"; done
	rm -rf "${DEST:?}/$n" && mv "$tmp" "$DEST/$n"
done
if [ -d "$SRC/tuning" ]; then
	tmp="$DEST/.tuning.new"
	rm -rf "$tmp" && mkdir -p "$tmp"
	for t in "$SRC"/tuning/*.conf; do
		[ -s "$t" ] && install -m 0644 "$t" "$tmp/"
	done
	rm -rf "${DEST:?}/tuning" && mv "$tmp" "$DEST/tuning"
fi
status
echo "restart the filter to use them: systemctl --user restart aurora-camera-denoise"
